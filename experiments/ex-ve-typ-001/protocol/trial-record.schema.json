{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/ex-ve-typ-001/trial-record.schema.json",
  "title": "EX-VE-TYP-001 Trial Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "protocolVersion",
    "participantId",
    "participantIndex",
    "sessionNumber",
    "task",
    "conditionId",
    "stimulusId",
    "durationMs",
    "accuracy",
    "effort",
    "confidence",
    "corrections",
    "abandoned"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "experimentId": { "const": "EX-VE-TYP-001" },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "participantId": {
      "type": "string",
      "minLength": 1,
      "description": "Study-assigned pseudonym only; never a name or email."
    },
    "participantIndex": { "type": "integer", "minimum": 0 },
    "sessionNumber": { "enum": [1, 2] },
    "task": {
      "enum": ["PROSE", "LABEL", "IDENT", "DENSE"]
    },
    "conditionId": { "type": "string", "pattern": "^TYP-C[0-9]{3}$" },
    "stimulusId": { "type": "string", "minLength": 1 },
    "durationMs": { "type": "integer", "minimum": 1 },
    "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "comprehension": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "effort": { "type": "integer", "minimum": 1, "maximum": 7 },
    "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
    "preference": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
    "corrections": { "type": "integer", "minimum": 0 },
    "regressions": { "type": ["integer", "null"], "minimum": 0 },
    "abandoned": { "type": "boolean" },
    "deviceClass": {
      "enum": ["desktop", "tablet", "mobile", "unknown"]
    },
    "viewportWidthPx": { "type": ["integer", "null"], "minimum": 1 },
    "viewportHeightPx": { "type": ["integer", "null"], "minimum": 1 },
    "devicePixelRatio": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "reducedMotion": { "type": ["boolean", "null"] },
    "forcedColors": { "type": ["boolean", "null"] }
  }
}
