{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application Polish Scenario Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "surface",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string"
    },
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "baseDir": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "probe",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    }
  }
}
