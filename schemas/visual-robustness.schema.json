{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/visual-engineering/visual-robustness.schema.json",
  "title": "Visual Engineering Perceptual Robustness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "states"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criticality", "channels", "programmaticSemantics"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "criticality": {
            "enum": ["informational", "important", "critical"]
          },
          "channels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "hue",
                "luminance",
                "text-label",
                "icon-shape",
                "border-shape",
                "pattern",
                "position",
                "motion"
              ]
            }
          },
          "programmaticSemantics": { "type": "boolean" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lostChannels"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "lostChannels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "hue",
                "luminance",
                "text-label",
                "icon-shape",
                "border-shape",
                "pattern",
                "position",
                "motion"
              ]
            }
          }
        }
      }
    }
  }
}
